# Copy to .env and fill with real values.
# NEVER commit .env or paste real connection strings in issues/PRs.
# Use only localhost or placeholders in this file.
# Frontend (npm start) בדרך כלל על 3000; הבקאנד על PORT — כדי שלא יתנגשו עם CRA.
PORT=3001
# כתובת ציבורית של הבקאנד (ל-OAuth redirect). בפיתוח בדרך כלל לא צריך — נגזר מ-localhost+PORT
# BACKEND_PUBLIC_URL=http://localhost:3001
MONGO_URI=mongodb://localhost:27017/brickshare
JWT_SECRET=change_this_to_a_long_random_secret
JWT_REFRESH_SECRET=change_this_to_another_long_random_secret
GEMINI_API_KEY=
FRONTEND_URL=http://localhost:3000
# OAuth (optional) — callback חייב להיות כתובת מלאה של הבקאנד (אותו PORT כמו למעלה)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:3001/api/auth/facebook/callback
